# ── Database (Supabase Transaction Pooler - port 6543) ────────────────────────
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ── Supabase (server-side) ────────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── Supabase (frontend - VITE_ prefix required by Vite) ──────────────────────
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-64-random-chars

# ── LLM / AI (OpenAI or any OpenAI-compatible provider) ──────────────────────
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=   # leave blank for OpenAI; set for Groq/Together/Azure

# ── Voice Narration (optional) ────────────────────────────────────────────────
ELEVENLABS_API_KEY=

# ── Email (optional) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
OWNER_EMAIL=

# ── Payments - Tap Payments (optional) ───────────────────────────────────────
TAP_SECRET_KEY=
TAP_PUBLIC_KEY=
TAP_WEBHOOK_SECRET=

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
VITE_APP_TITLE=MicroLearning Coach
